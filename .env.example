# voicelab server configuration. Copy to `.env` (git-ignored) and fill in what you have.
#
# Every key is optional. A missing key degrades gracefully and the server logs
# which providers are live at startup:
#   - no ANTHROPIC_API_KEY   -> offline rule-based agent (same tools, no LLM)
#   - no DEEPGRAM/ELEVENLABS -> speech recognition in the browser (Web Speech API)
#   - no ELEVENLABS_API_KEY  -> speech synthesis in the browser (speechSynthesis)
# With zero keys the app still runs end to end.

# ---------------------------------------------------------------- server
# HTTP + WebSocket port (WebSocket path is /ws).
PORT=8787
# Bind address. Use 127.0.0.1 to keep it off the network.
HOST=0.0.0.0
# "production" serves apps/web/dist from this server (after `npm run build`).
NODE_ENV=development
# auto (= only in production) | true | false
VOICELAB_SERVE_WEB=auto
# debug | info | warn | error
VOICELAB_LOG_LEVEL=info

# Paths (defaults are relative to the repo root).
# Directory of SOP YAML/JSON files loaded at startup.
# VOICELAB_SOP_DIR=./sops
# Run logs are appended to <dir>/sessions/<runId>.jsonl.
# VOICELAB_DATA_DIR=./data
# Built web UI to serve in production.
# VOICELAB_WEB_DIST=./apps/web/dist

# ---------------------------------------------------------------- LLM (Claude)
# anthropic | offline
VOICELAB_LLM=anthropic
# Claude API key. ANTHROPIC_AUTH_TOKEN also works. Without either, the offline agent is used.
ANTHROPIC_API_KEY=
# Model ID.
VOICELAB_LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max. Opus 5.5 always thinks; effort is the latency lever.
# "low" keeps time-to-first-word short for voice. (The API default for this model is medium.)
VOICELAB_LLM_EFFORT=low
# Per-turn output cap (thinking + spoken reply + tool calls).
VOICELAB_LLM_MAX_TOKENS=8000
# User turns kept before the conversation is compacted into a summary.
VOICELAB_LLM_HISTORY_TURNS=24

# ---------------------------------------------------------------- speech-to-text
# deepgram | elevenlabs | browser
VOICELAB_STT=deepgram

# Deepgram live streaming (wss://api.deepgram.com/v1/listen). Keyterms are generated
# from the active SOP's reagents/aliases/equipment plus lab units.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# Silence (ms) before Deepgram finalizes a segment. Raise if people pause mid-number.
DEEPGRAM_ENDPOINTING_MS=300
# Gap (ms) that ends an utterance (>= 1000).
DEEPGRAM_UTTERANCE_END_MS=1000
DEEPGRAM_LANGUAGE=en

# ---------------------------------------------------------------- text-to-speech
# elevenlabs | browser | off
VOICELAB_TTS=elevenlabs

# ElevenLabs: used for TTS and, with VOICELAB_STT=elevenlabs, Scribe realtime STT.
ELEVENLABS_API_KEY=
# Voice to speak with. Defaults to a premade voice; pick a calm, clear one for production.
ELEVENLABS_VOICE_ID=
# Low-latency TTS model.
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# PCM output sample rate sent to the browser: 16000 | 22050 | 24000 | 44100
ELEVENLABS_TTS_SAMPLE_RATE=24000
# Realtime STT model (when VOICELAB_STT=elevenlabs).
ELEVENLABS_STT_MODEL=scribe_v2_realtime
