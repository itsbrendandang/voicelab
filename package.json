{
  "name": "voicelab",
  "private": true,
  "version": "0.1.0",
  "description": "Real-time voice assistant for lab benches: SOP-aware, calculation-safe, safety-first.",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm:dev -w @voicelab/server\" \"npm:dev -w @voicelab/web\"",
    "build": "npm run build -w @voicelab/web",
    "start": "npm start -w @voicelab/server",
    "typecheck": "tsc -p packages/core && tsc -p apps/server && tsc -p apps/web",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22",
    "concurrently": "^9",
    "tsx": "^4",
    "typescript": "~5.9.3",
    "vitest": "^5"
  }
}
